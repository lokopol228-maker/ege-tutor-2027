# Database (SQLite by default — no Render Postgres needed)
DATABASE_URL="file:./prisma/data/prod.db"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Login (no public signup)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="strong-password-here"
ADMIN_NAME="Ученик"

# Optional: AI keys can also be set in the site Settings page after login
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
