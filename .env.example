# Database (Render Postgres — free)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ege_tutor?sslmode=require"

# Auth
NEXTAUTH_URL="https://YOUR-SERVICE.onrender.com"
NEXTAUTH_SECRET="сгенерируй-длинную-случайную-строку"

# Единственный доступ (публичной регистрации нет)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="strong-password-here"
ADMIN_NAME="Ученик"

# ===== Бесплатный ИИ-репетитор =====
# В РФ чаще работает Groq (Gemini может быть недоступен по региону)

# 1) Рекомендую для РФ: Groq
# https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 2) Google Gemini (если регион доступен)
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Если ключей нет — встроенный офлайн-репетитор (бесплатно)
